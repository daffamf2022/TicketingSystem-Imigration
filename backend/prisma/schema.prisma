datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String              @id @default(uuid())
  username           String              @unique
  nik                String              @unique
  name               String
  email              String              @unique
  password           String
  role               String              @default("CUSTOMER")
  nip                String?             @unique
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  reservations       Reservation[]
  passwordResetToken PasswordResetToken?

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Quota {
  id             String        @id @default(uuid())
  date           DateTime      @db.Date
  startTime      String        @map("start_time") // e.g. "08:00"
  endTime        String        @map("end_time") // e.g. "10:00"
  maxQuota       Int           @map("max_quota")
  remainingQuota Int           @map("remaining_quota")
  cutoffMinutes  Int?          @map("cutoff_minutes") // Set by service unit; null/0 means no cut-off
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  reservations   Reservation[]

  @@unique([date, startTime, endTime])
  @@map("quotas")
}

model Reservation {
  id              String     @id @default(uuid())
  userId          String     @map("user_id")
  quotaId         String     @map("quota_id")
  applicationCode String     @unique @map("application_code")
  queueNumber     String?    @map("queue_number")
  status          String      @default("PENDING") // PENDING, VERIFIED, REJECTED, COMPLETED, CANCELLED
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quota           Quota      @relation(fields: [quotaId], references: [id], onDelete: Restrict)
  companion       Companion?
  documents       Document[]

  @@unique([quotaId, queueNumber])
  @@map("reservations")
}

model Companion {
  id                      String      @id @default(uuid())
  reservationId           String      @unique @map("reservation_id")
  needsDisabilityFacility Boolean     @default(false) @map("needs_disability_facility")
  disabilityType          String?     @map("disability_type") // tunanetra, kursi_roda, dll.
  companionName           String?     @map("companion_name")
  companionNik            String?     @map("companion_nik")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")
  reservation             Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("companions")
}

model Document {
  id            String      @id @default(uuid())
  reservationId String      @map("reservation_id")
  documentType  String      @map("document_type") // KTP, KK, AKTA_KELAHIRAN, dll.
  filePath      String      @map("file_path")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("documents")
}
